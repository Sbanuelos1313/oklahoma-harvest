{
  "expo": {
    "name": "From Our Place",
    "slug": "mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#F0E6D3"
    },
    "ios": {
      "bundleIdentifier": "com.chronosai.fromourplace",
      "buildNumber": "1",
      "supportsTablet": false
    },
    "android": {
      "package": "com.chronosai.fromourplace",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F0E6D3"
      }
    },
    "plugins": [
      "expo-build-properties"
    ],
    "extra": {
      "eas": {
        "projectId": "8b6ab2d1-cb5e-4073-964a-cf81814c92cd"
      }
    }
  }
}












































